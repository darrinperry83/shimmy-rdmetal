+#ifdef RDMETAL_IMAGE_CANDIDATE
+extern const struct drisw_loader_funcs drisw_lf;
+/* No DRM fd is fabricated. The Gallium screen comes from the software winsys
+ * while its render targets can be broker-backed rdmetal resources. */
+static const __DRIconfig **
+rdmetal_image_init_screen(struct dri_screen *screen)
+{
+   struct pipe_screen *pscreen = NULL;
+   const __DRIconfig **configs;
+   (void)mtx_init(&screen->opencl_func_mutex, mtx_plain);
+   /* GBM/EGL pass the DRM render-node fd here even for a software driver
+    * (the loader only fabricates fd == -1 for the pure-swrast fallback).
+    *
+    * Use the KMS software winsys when a real DRM fd is present so softpipe
+    * render targets are DRM dumb buffers: those are the SAME host backing the
+    * shim's present path (drmasahi.c PRIME_HANDLE_TO_FD -> drm_bo_map_by_fd)
+    * reads, so a CPU-rendered frame is exported/imported as a dma-buf and
+    * reaches the compositor non-black. Fall back to the SHM winsys when no
+    * fd is available. */
+   bool probed = false;
+#ifdef HAVE_DRISW_KMS
+   if (screen->fd >= 0 && pipe_loader_sw_probe_kms(&screen->dev, screen->fd))
+      probed = true;
+#endif
+   if (!probed && !pipe_loader_sw_probe_dri(&screen->dev, &drisw_lf))
+      return NULL;
+   pscreen = pipe_loader_create_screen(screen->dev);
+   if (!pscreen)
+      goto fail;
+   dri_init_options(screen);
+   screen->throttle = pscreen->get_param(pscreen, PIPE_CAP_THROTTLE);
+   dri2_init_screen_extensions(screen, pscreen, false);
+   configs = dri_init_screen(screen, pscreen);
+   if (!configs)
+      goto fail;
+   screen->can_share_buffer = true;
+   screen->auto_fake_front = dri_with_format(screen);
+   screen->lookup_egl_image = dri2_lookup_egl_image;
+   screen->create_drawable = dri2_create_drawable;
+   screen->allocate_buffer = dri2_allocate_buffer;
+   screen->release_buffer = dri2_release_buffer;
+   return configs;
+fail:
+   pipe_loader_release(&screen->dev, 1);
+   return NULL;
+}
